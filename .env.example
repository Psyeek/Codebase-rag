# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1 (Cloud / Managed DB): Supabase, Neon, Railway, or Render Postgres URL
# If DATABASE_URL is set, it takes precedence over POSTGRES_* below:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require

# Option 2 (Local / Docker Compose):
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# ==============================================================================
# LLM Provider (Groq)
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# Frontend Configuration (Optional)
# ==============================================================================
# Set when frontend is hosted separately (e.g., on Vercel, Netlify, Cloudflare Pages)
# Example: VITE_API_BASE_URL=https://your-backend-service.onrender.com
# Leave blank when running via Docker Compose (Nginx reverse-proxies API calls automatically)
VITE_API_BASE_URL=